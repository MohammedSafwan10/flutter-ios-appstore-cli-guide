# ==============================================================================
# App Store Connect API Credentials (TEMPLATE - DO NOT PUT REAL SECRETS HERE)
# Copy this file to .env and provide your organization's credentials.
# Note: .env is gitignored and will never be committed.
# ==============================================================================

# 10-character Key ID from App Store Connect (Users and Access -> Integrations -> Keys)
APPSTORE_KEY_ID="YOUR_KEY_ID"

# Issuer UUID from App Store Connect
APPSTORE_ISSUER_ID="00000000-0000-0000-0000-000000000000"

# Absolute path to the downloaded .p8 private key file on the local machine
# Example: /Users/username/private_keys/AuthKey_YOUR_KEY_ID.p8
APPSTORE_KEY_PATH="/path/to/AuthKey_YOUR_KEY_ID.p8"

# 10-character Apple Developer Team ID
APPLE_TEAM_ID="YOUR_TEAM_ID"
